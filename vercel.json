{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": "backend",
      "framework": "fastapi",
      "entrypoint": "app.main:app"
    },
    "web-app": {
      "root": "web-app",
      "framework": "vite"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "backend" } },
    { "source": "/podcasts", "destination": { "service": "web-app", "path": "/index.html" } },
    { "source": "/podcasts/(.*)", "destination": { "service": "web-app", "path": "/index.html" } },
    { "source": "/(.*)", "destination": { "service": "web-app" } }
  ]
}
